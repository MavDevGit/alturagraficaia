{
  "name": "alturagraficaia-pwa",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/image-service"
  ],
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    },
    "minimatch": {
      "brace-expansion": "5.0.9"
    }
  },
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "dev": "concurrently -k -n web,image,api,queue,auth -c cyan,magenta,green,yellow,blue \"npm run dev -w apps/web -- --host 127.0.0.1\" \"npm run dev -w apps/image-service\" \"npm run api:serve\" \"npm run api:queue\" \"firebase emulators:start --only auth --project altura-grafica-ia\"",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "local:start:quick": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1 -SkipBuild",
    "local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/status-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "tunnel:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cloudflare.ps1",
    "tunnel:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-cloudflare.ps1",
    "fal:local:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-fal-key-local.ps1",
    "prod:local": "npm run build:local && npm run preview -w apps/web -- --host 127.0.0.1 --port 4173 --strictPort",
    "prod:local:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-preview.ps1",
    "api:serve": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/php.ps1 apps/api/artisan serve --host=127.0.0.1 --port=8000",
    "api:queue": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/php.ps1 apps/api/artisan queue:work --tries=2 --timeout=180",
    "contracts": "openapi-typescript packages/contracts/openapi.yaml -o apps/web/src/api/schema.d.ts",
    "build": "npm run build -w apps/image-service && npm run build -w apps/web",
    "build:local": "npm run build -w apps/image-service && npm run build:local-production -w apps/web",
    "lint": "npm run lint -w apps/image-service && npm run lint -w apps/web",
    "test": "npm run test -w apps/image-service && npm run test -w apps/web && npm run test:api",
    "test:api": "node scripts/run-api-tests.mjs",
    "test:api:postgres": "node scripts/run-api-tests.mjs --postgres",
    "test:e2e": "playwright test",
    "test:pwa": "npm run build -w apps/web && playwright test -c playwright.pwa.config.ts",
    "format": "prettier --write \"apps/{web,image-service}/src/**/*.{ts,tsx,css}\" \"packages/contracts/**/*.yaml\""
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@firebase/firestore": "^4.17.0",
    "@mui/utils": "^9.2.0",
    "@playwright/test": "^1.55.0",
    "ajv": "^8.20.0",
    "common-tags": "^1.8.2",
    "concurrently": "^9.2.1",
    "css-tree": "^3.2.1",
    "dom-helpers": "^6.0.1",
    "esbuild": "^0.28.1",
    "firebase-tools": "15.24.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.6.2",
    "resolve": "^1.22.12",
    "uuid": "^11.1.1",
    "vitest": "^4.1.10"
  }
}
