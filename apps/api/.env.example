IMAGE_JOBS_HARD_LIMIT=100
GCS_CLASS_A_SOFT_LIMIT=4200
GCS_CLASS_A_HARD_LIMIT=4700
JOB_STALE_MINUTES=720
DB_QUEUE_RETRY_AFTER=1000
