FILESYSTEM_DISK=local
GCP_PROJECT_ID=altura-grafica-ia
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
IMAGE_SERVICE_URL=http://127.0.0.1:8787
IMAGE_SERVICE_AUDIENCE=
IMAGE_SERVICE_KEY=change-me-locally
IMAGE_CALLBACK_SECRET=change-me-locally
ASSET_TTL_DAYS=7
ASSET_VIEWER_TOKEN_TTL=14400
INITIAL_CREDITS=20
MAX_UPLOAD_KB=51200
MAX_INPUT_SIDE=20000
MAX_INPUT_PIXELS=100000000
MAX_OUTPUT_SIDE=32768
MAX_OUTPUT_PIXELS=400000000
STORAGE_SOFT_LIMIT_BYTES=3758096384
STORAGE_HARD_LIMIT_BYTES=4294967296
