APP_NAME="Altura Gráfica IA"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://app.example.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alturagrafica_pwa
DB_USERNAME=alturagrafica
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=queue_jobs
DB_QUEUE_RETRY_AFTER=1000

AUTH_DRIVER=firebase
FIREBASE_PROJECT_ID=REPLACE_PROJECT_ID
FIREBASE_CREDENTIALS=
FIREBASE_AUTH_EMULATOR_HOST=

FILESYSTEM_DISK=gcs
GCP_PROJECT_ID=REPLACE_PROJECT_ID
GCS_BUCKET=REPLACE_PRIVATE_BUCKET
GOOGLE_APPLICATION_CREDENTIALS=
IMAGE_SERVICE_URL=https://altura-image-service-REPLACE_HASH-uc.a.run.app
IMAGE_SERVICE_AUDIENCE=https://altura-image-service-REPLACE_HASH-uc.a.run.app
IMAGE_SERVICE_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
IMAGE_CALLBACK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

ASSET_TTL_DAYS=7
ASSET_VIEWER_TOKEN_TTL=14400
INITIAL_CREDITS=20
MAX_UPLOAD_KB=51200
MAX_INPUT_SIDE=20000
MAX_INPUT_PIXELS=100000000
MAX_OUTPUT_SIDE=32768
MAX_OUTPUT_PIXELS=400000000
STORAGE_SOFT_LIMIT_BYTES=3758096384
STORAGE_HARD_LIMIT_BYTES=4294967296
IMAGE_JOBS_SOFT_LIMIT=80
IMAGE_JOBS_HARD_LIMIT=100
GCS_CLASS_A_SOFT_LIMIT=4200
GCS_CLASS_A_HARD_LIMIT=4700
JOB_STALE_MINUTES=720
CORS_ALLOWED_ORIGINS=https://app.example.com

FAL_KEY_CONFIGURED=true
FAL_KEY_ROTATED_AT=REPLACE_WITH_SET_FAL_KEY_SCRIPT_UTC_DATE
